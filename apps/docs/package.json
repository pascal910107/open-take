{
  "name": "@open-take/docs",
  "version": "0.0.0",
  "private": true,
  "description": "The docs — a Fumadocs (Next) app serving everything under /docs. Never published to npm; deploy beside the landing (apps/web) with /docs/* rewritten here.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --port 4180",
    "build": "next build",
    "start": "next start --port 4180",
    "postinstall": "fumadocs-mdx",
    "typecheck": "next typegen && tsc --noEmit",
    "clean": "rm -rf .next .source"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.8",
    "fumadocs-core": "16.13.0",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.13.0",
    "next": "16.2.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.6.3"
  }
}
